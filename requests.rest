@base-url = http://localhost:8080
@token = {{login.response.body.accessToken}}

### 1. AUTHENTICATION

# @name register
POST {{base-url}}/api/auth/register
Content-Type: application/json

{
  "fullName": "New Customer",
  "email": "customer@example.com",
  "phoneNumber": "0780000001",
  "password": "Password123!"
}

###

# @name verifyOtp
POST {{base-url}}/api/auth/verify-otp
Content-Type: application/json

{
  "email": "customer@example.com",
  "otp": "123456"
}

###

# @name login
POST {{base-url}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@wasac.gov.rw",
  "password": "AdminPassword123!"
}

### 2. USER MANAGEMENT (Admin Only)

# @name getAllUsers
GET {{base-url}}/api/users
Authorization: Bearer {{token}}

###

# @name getUserById
GET {{base-url}}/api/users/1
Authorization: Bearer {{token}}

###

# @name createUser
POST {{base-url}}/api/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "Finance Officer",
  "email": "finance@wasac.gov.rw",
  "phoneNumber": "0780000002",
  "password": "Password123!",
  "role": "ROLE_FINANCE",
  "status": "ACTIVE"
}

### 3. CUSTOMER MANAGEMENT (Admin Only)

# @name getAllCustomers
GET {{base-url}}/api/customers
Authorization: Bearer {{token}}

###

# @name createCustomer
POST {{base-url}}/api/customers
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullNames": "John Doe",
  "nationalId": "1199080012345678",
  "email": "john.doe@example.com",
  "phone": "0781234567",
  "address": "Kigali, Rwanda",
  "status": "ACTIVE"
}

### 4. METER MANAGEMENT (Admin Only)

# @name getAllMeters
GET {{base-url}}/api/meters
Authorization: Bearer {{token}}

###

# @name createMeter
POST {{base-url}}/api/meters
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "meterNumber": "WTR-1001",
  "meterType": "WATER",
  "customerId": 1,
  "status": "ACTIVE"
}

### 5. METER READINGS (Operator/Admin Only)

# @name captureReading
POST {{base-url}}/api/readings
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "meterId": 1,
  "currentReading": 150.5,
  "month": 6,
  "year": 2026
}

### 6. BILLING MANAGEMENT

# @name getAllBills
GET {{base-url}}/api/bills
Authorization: Bearer {{token}}

###

# @name getMyBills (Customer Only)
GET {{base-url}}/api/bills/customer/1
Authorization: Bearer {{token}}

###

# @name approveBill (Finance/Admin Only)
PATCH {{base-url}}/api/bills/1/approve
Authorization: Bearer {{token}}

###

# @name calculatePenalties (Finance/Admin Only)
POST {{base-url}}/api/bills/calculate-penalties
Authorization: Bearer {{token}}

### 7. PAYMENT PROCESSING

# @name processPayment
POST {{base-url}}/api/payments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "billId": 1,
  "amount": 5000.0,
  "method": "MOBILE_MONEY"
}

###

# @name getPaymentHistory
GET {{base-url}}/api/payments/bill/1
Authorization: Bearer {{token}}

### 8. TARIFF & PENALTY MANAGEMENT (Admin Only)

# @name getAllTariffs
GET {{base-url}}/api/tariffs
Authorization: Bearer {{token}}

###

# @name createTariff
POST {{base-url}}/api/tariffs
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "meterType": "WATER",
  "tariffType": "FLAT_RATE",
  "rate": 350.0
}

###

# @name createPenalty
POST {{base-url}}/api/tariffs/penalties
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Standard Overdue Penalty",
  "fixedAmount": 2000.0,
  "percentagePerMonth": 2.5,
  "active": true
}

###

# @name getActivePenalty
GET {{base-url}}/api/tariffs/penalties/active
Authorization: Bearer {{token}}